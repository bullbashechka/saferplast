---
import { workProcessContent } from "@/features/landing/work-process-content";

function getDesktopTitleLines(step: string, titleLines: readonly string[]) {
  return step === "2" ? (["Расчет", "Подбор решения"] as const) : titleLines;
}
---

<section aria-labelledby="work-process-title" class="scroll-reveal bg-[rgba(250,254,255,1)] px-[var(--landing-mobile-shell-x)] pb-0 pt-[60px] md:mt-[120px] md:px-5 md:pt-0 min-[1025px]:px-8">
  <div class="landing-mobile-shell mx-auto md:max-w-content">
    <h2 id="work-process-title" class="text-center font-['Sansation'] text-[20px] font-normal leading-[1] tracking-[0] text-[#004B62] md:font-sans md:text-[2.4375rem] md:font-medium min-[1025px]:text-[2.5rem]">
      {workProcessContent.title}
    </h2>
    <p class="mx-auto mt-[10px] max-w-full text-center font-['Montserrat'] text-[12px] font-normal leading-[1] tracking-[0] text-[#242424] md:mt-4 md:max-w-[30.125rem] md:font-sans md:text-[0.9375rem] min-[1025px]:text-[1rem]">
      {workProcessContent.subtitle}
    </p>

    <div class="mt-[20px] space-y-[10px] md:hidden">
      {workProcessContent.cards.map((card) => (
        <article class="landing-mobile-card relative mx-auto h-[188px] overflow-hidden rounded-[10px] bg-[#d9e5ea]">
          <img
            alt={card.titleLines.join(" ")}
            class="absolute inset-0 block h-full w-full object-cover"
            loading="lazy"
            src={card.imageSrc}
          />
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,75,98,0.12)_0%,rgba(0,0,0,0.18)_100%)]" />

          <div class="absolute left-[7px] right-[7px] top-[7px] h-[51px]">
            <div class="liquid-glass-strong flex h-full w-full items-center gap-[25px] rounded-[10px] p-[5px]">
              <div class="relative h-[41px] w-[43px] shrink-0">
                <img alt="" aria-hidden="true" class="absolute inset-0" loading="lazy" src="/icons/square.svg" />
                <span class="absolute inset-0 flex items-center justify-center font-display text-[34px] font-normal leading-[1] text-[#004B62]">
                  {card.step}
                </span>
              </div>

              <h3 class="relative z-10 flex min-w-0 flex-1 flex-col justify-center font-['Sansation'] text-[18px] font-normal leading-[1] tracking-[0] text-[#004B62]">
                {card.titleLines.map((line, index) => (
                  <span class={index === 1 ? "block whitespace-nowrap" : "block"}>{line}</span>
                ))}
              </h3>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="hidden md:mt-8 md:grid md:grid-cols-3 md:gap-4 min-[1025px]:mt-10 min-[1025px]:gap-[19px]">
      {workProcessContent.cards.map((card) => {
        const desktopTitleLines = getDesktopTitleLines(card.step, card.titleLines);
        const desktopImageSrc = card.id === "installation" ? "/images/original/kidsrun.jpg" : card.imageSrc;

        return (
          <article class="relative h-[188px] overflow-hidden rounded-[20px] bg-[#d9e5ea] min-[1025px]:h-[329px]">
            <img
              alt={desktopTitleLines.join(" ")}
              class="absolute inset-0 block h-full w-full object-cover"
              loading="lazy"
              src={desktopImageSrc}
            />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,75,98,0.12)_0%,rgba(0,0,0,0.18)_100%)]" />

            <div class="absolute left-[9px] right-[9px] top-[11px]">
              <div class="liquid-glass-strong rounded-[15px] p-4 pb-5 md:min-h-[6rem] min-[1025px]:pb-4">
                <div class="relative z-10 flex items-start gap-4">
                  <div class="relative left-[5px] h-[52px] w-[54px] shrink-0 min-[1025px]:h-[55.00013px] min-[1025px]:w-[57px]">
                    <img alt="" aria-hidden="true" class="absolute inset-0" loading="lazy" src="/icons/square.svg" />
                    <span class="absolute inset-0 flex items-center justify-center font-display text-[43px] font-normal leading-[1] text-[#004B62] min-[1025px]:text-[45px]">
                      {card.step}
                    </span>
                  </div>

                  <h3 class="flex min-h-[3.75rem] min-w-0 max-w-[16rem] flex-1 flex-col justify-between gap-0 pl-[5px] text-[1.4375rem] font-medium leading-[1] text-[#004B62] min-[1025px]:h-[55px] min-[1025px]:text-[1.5rem]">
                    {desktopTitleLines.map((line, index) => (
                      <span class={index === 1 ? "block whitespace-nowrap" : "block"}>{line}</span>
                    ))}
                  </h3>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
