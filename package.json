{
  "name": "saferplast-main",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "generate:public": "node scripts/generate-public-files.mjs",
    "check:env": "node scripts/validate-frontend-env.mjs",
    "check:release": "npm run lint && npm run typecheck && npm run build",
    "preflight:pages": "node scripts/preflight-deploy.mjs pages",
    "preflight:worker": "node scripts/preflight-deploy.mjs worker",
    "predev": "npm run generate:public",
    "prebuild": "npm run generate:public && npm run check:env",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:pages": "npm run check:release && npm run preflight:pages && wrangler pages deploy dist --project-name saferplast",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "npm run preflight:worker && wrangler deploy --config worker/wrangler.jsonc",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.0",
    "astro": "^5.18.1",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.80.0"
  }
}
